double matern(double t, double sig, double rho, double nu) {
  if (t == 0.0) return sig*sig;
  double arg = sqrt(2.0*nu)*t/rho;
  return (sig*sig*pow(2.0, 1.0-nu)/gamma(nu))*pow(arg, nu)*besselk(nu, arg);
}

