double _intermediate_small_base(double v, double x) {
    double u = v*v;
    double z = log(x);
    double sx = _fma(u, (2.0/(1.010025 -0.0)), - ((1.010025 +0.0)/(1.010025 -0.0)));
    double sy = _fma(z, (2.0/(1.3862943611198906 -(-0.6931471805599453))), - ((1.3862943611198906 +(-0.6931471805599453))/(1.3862943611198906 -(-0.6931471805599453))));
    double r = _cheby2d(sx, sy, INTERMEDIATE_SMALL_COEFS[0], 16, 11);
    return (sqrt(3.14159265358979323846/2))*r/sqrt(x);
}

double _intermediate_large_base(double v, double x) {
    double u = v*v;
    double w = 1/x;
    double sx = _fma(u, (2.0/(1.0201 -0.0)), - ((1.0201 +0.0)/(1.0201 -0.0)));
    double sy = _fma(w, (2.0/(0.25 -0.05)), - ((0.25 +0.05)/(0.25 -0.05)));
    double r = _cheby2d(sx, sy, INTERMEDIATE_LARGE_COEFS[0], 13, 8);
    return (sqrt(3.14159265358979323846/2))*r/sqrt(x);
}

PairOrders intermediate_pair_orders(double v, double delta) {
    double mu = fabs(v);
    if (mu <= 1.0 + delta) {
        return (PairOrders){ mu, fabs(mu - 1.0), mu, 0 };
    }
    double n = floor(mu);
    double alpha = mu - n;
    return (PairOrders){ alpha, fabs(alpha - 1.0), alpha, (int)n };
}

double _intermediate_forward_recurrence(double kprev, double kcur, double alpha, size_t niter, double x) {
    double km1 = kprev;
    double k0 = kcur;

    for (size_t j = 0; j < niter; j++) {
        double nu = alpha + j;
        double kp1 = km1 + (2*nu/x)*k0;
        km1 = k0;
        k0 = kp1;
    }
    return k0;

}

double _intermediate_besselkx(double v, double x, double delta, double (*base)(double, double)) {
    PairOrders p = intermediate_pair_orders(v, delta);
    double kcur = base(p.order_cur, x);

    if (p.nsteps == 0) return kcur;

    double kprev = base(p.order_prev, x);
    return _intermediate_forward_recurrence(kprev, kcur, p.order_start, p.nsteps, x);
}

double _intermediate_besselkx_2(double v, double x) {
    double (*base)(double, double);

    if (x <= 4.0) {
        base = &_intermediate_small_base;
        return _intermediate_besselkx(v, x, 0.005, base);
    }
    base = &_intermediate_large_base;
    return _intermediate_besselkx(v, x, 0.01, base);
}

double _besselk_intermediate(double v, double x, _Bool modify) {
    double kx = _intermediate_besselkx_2(v, x);
    return modify ? exp(v*log(x) - x)*kx : exp(-x)*kx;
}
